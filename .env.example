# ==============================================================================
# PayPal Agentic Commerce Suite - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for AI Cognitive Decision Loop & Architecture Studio)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# PayPal Developer Sandbox Credentials (Optional for mock mode; Required for live Sandbox)
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"
PAYPAL_ENVIRONMENT="sandbox"

# Channel3 Commerce API (Optional for mock syndication; Required for live multi-merchant API)
# Obtain from: https://channel3.tv
CHANNEL3_API_KEY="your_channel3_api_key_here"

# Application Hosting Port
PORT=3000
NODE_ENV="development"
